# Copia este archivo como ".env" y rellena tus claves.
# Sin esto, Jarvis sigue funcionando con sus reglas locales (0 costo).

# --- Cerebro API ------------------------------------------------------------
OPENAI_API_KEY=
# Compatible con cualquier servidor OpenAI (déjalo vacío para usar OpenAI oficial).
# Ejemplos:
#   Groq (gratis):   https://api.groq.com/openai/v1
#   LM Studio local: http://localhost:1234/v1
OPENAI_BASE_URL=
JARVIS_MODEL=gpt-4o-mini

# --- Sistema ----------------------------------------------------------------
XAMPP_DIR=C:\xampp
JARVIS_MYSQL_PORT=3306
JARVIS_APACHE_PORT=80
# auto | wt (Windows Terminal) | cmd | powershell
JARVIS_TERMINAL=auto

# --- Voz --------------------------------------------------------------------
JARVIS_WAKE=hey jarvis
JARVIS_LANG=es
# tiny (más rápido) | base (equilibrado) | small (mejor precisión)
JARVIS_WHISPER=base
# Sensibilidad del micrófono: sube si no te detecta, baja si detecta ruido
JARVIS_ENERGY=400
# 1 = filtra ruido de fondo (tele/vídeos): solo reacciona a órdenes y preguntas
# 0 = responde a cualquier frase transcrita
JARVIS_FILTRO=1
# 1 = escucha permanente sin decir "hey jarvis" | 0 = esperar la frase
JARVIS_SIEMPRE=0
# Voz: auto (pyttsx3 con respaldo de Windows) | pyttsx3 | sapi | off
JARVIS_TTS=auto
# Umbral de la wake word (solo si JARVIS_SIEMPRE=0): baja a 0.25 si no te detecta
JARVIS_WAKE_THRESHOLD=0.35
# Segundos de conversación libre tras "hey jarvis"
JARVIS_SESION=90
